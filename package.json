{
  "name": "milo-ai",
  "displayName": "Milo AI",
  "publisher": "ayushman4107",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Evidence-aware, reversible coding changes through TrueForge",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0",
    "vscode": "^1.106.0"
  },
  "main": "./dist/extension.cjs",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:milo.open"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "milo.open",
        "title": "Milo: Open workbench"
      },
      {
        "command": "milo.run",
        "title": "Milo: Run repository task"
      },
      {
        "command": "milo.inline",
        "title": "Milo: Edit selection"
      },
      {
        "command": "milo.cancel",
        "title": "Milo: Cancel run"
      },
      {
        "command": "milo.undo",
        "title": "Milo: Undo last apply"
      },
      {
        "command": "milo.verify",
        "title": "Milo: Verify applied snapshot"
      },
      {
        "command": "milo.exportEvidence",
        "title": "Milo: Export run evidence"
      },
      {
        "command": "milo.recover",
        "title": "Milo: Inspect uncertain commit"
      },
      {
        "command": "milo.verifyDifferential",
        "title": "Milo: Verify base versus patch"
      },
      {
        "command": "milo.doctor",
        "title": "Milo: Setup doctor"
      },
      {
        "command": "milo.retry",
        "title": "Milo: Retry with note"
      },
      {
        "command": "milo.expandSelection",
        "title": "Milo: Expand to enclosing Python function"
      },
      {
        "command": "milo.saveJournal",
        "title": "Milo: Save applied changes with journal"
      },
      {
        "command": "milo.toggleSmallModel",
        "title": "Milo: Toggle small-model preset"
      },
      {
        "command": "milo.review.rejectNoise",
        "title": "Milo: Reject formatting-only hunks",
        "enablement": "milo.reviewActive"
      },
      {
        "command": "milo.review.undoDecision",
        "title": "Milo: Undo hunk decision",
        "enablement": "milo.reviewActive"
      },
      {
        "command": "milo.review.previous",
        "title": "Milo: Previous hunk",
        "enablement": "milo.reviewActive"
      },
      {
        "command": "milo.review.accept",
        "title": "Milo: Accept current hunk",
        "enablement": "milo.reviewActive"
      },
      {
        "command": "milo.review.next",
        "title": "Milo: Next hunk",
        "enablement": "milo.reviewActive"
      },
      {
        "command": "milo.review.reject",
        "title": "Milo: Reject current hunk",
        "enablement": "milo.reviewActive"
      },
      {
        "command": "milo.review.confirm",
        "title": "Milo: Apply selected hunks",
        "enablement": "milo.reviewActive"
      },
      {
        "command": "milo.review.verify",
        "title": "Milo: Verify all staged hunks",
        "enablement": "milo.reviewActive"
      },
      {
        "command": "milo.review.cancel",
        "title": "Milo: Cancel review",
        "enablement": "milo.reviewActive"
      }
    ],
    "configuration": {
      "title": "Milo AI",
      "properties": {
        "milo.trueforgeUrl": {
          "type": "string",
          "default": "http://127.0.0.1:18790",
          "description": "Local TrueForge origin. The editor extension and runtime must share a network namespace.",
          "scope": "machine"
        },
        "milo.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Ordered model names already configured in TrueForge. No provider calls originate in Milo.",
          "scope": "machine"
        },
        "milo.verifyExecutable": {
          "type": "string",
          "default": "",
          "description": "Trusted test executable for a disposable Git-visible repository snapshot. This is not an OS sandbox.",
          "scope": "machine"
        },
        "milo.verifyArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed directly to the trusted verification executable; no shell interpolation.",
          "scope": "machine"
        },
        "milo.pythonExecutable": {
          "type": "string",
          "default": "",
          "description": "Trusted Python interpreter used for isolated AST parsing. Empty uses python3 (Linux) or python (Windows).",
          "scope": "machine"
        },
        "milo.smallModel": {
          "type": "boolean",
          "default": false,
          "description": "Use shorter reads, smaller context and a 24-iteration repository limit. Inline edits use 12 iterations.",
          "scope": "machine"
        },
        "milo.scout": {
          "type": "boolean",
          "default": false,
          "description": "Run a separate read-only TrueForge Scout session before repository edits. This adds model usage.",
          "scope": "machine"
        },
        "milo.verifyImport": {
          "type": "string",
          "default": "",
          "description": "Python module whose import must resolve inside the temporary tree. Empty auto-detects a single src package.",
          "scope": "machine"
        },
        "milo.verifyFixturePaths": {
          "scope": "machine",
          "type": "array",
          "description": "Exact Git-visible fixture paths to include despite secret-name exclusions during verification only. Use only for reviewed non-secret test data; never API keys.",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "keybindings": [
      {
        "command": "milo.inline",
        "when": "editorTextFocus && editorHasSelection && isWorkspaceTrusted",
        "key": "ctrl+k ctrl+alt+i",
        "mac": "cmd+k ctrl+alt+i"
      },
      {
        "command": "milo.review.accept",
        "when": "milo.reviewActive && !inputFocus",
        "key": "ctrl+k ctrl+alt+a",
        "mac": "cmd+k ctrl+alt+a"
      },
      {
        "command": "milo.review.reject",
        "when": "milo.reviewActive && !inputFocus",
        "key": "ctrl+k ctrl+alt+r",
        "mac": "cmd+k ctrl+alt+r"
      },
      {
        "command": "milo.review.confirm",
        "when": "milo.reviewActive && !inputFocus",
        "key": "ctrl+k ctrl+alt+enter",
        "mac": "cmd+k ctrl+alt+enter"
      },
      {
        "command": "milo.cancel",
        "when": "isWorkspaceTrusted && !inputFocus",
        "key": "ctrl+k ctrl+alt+q",
        "mac": "cmd+k ctrl+alt+q"
      },
      {
        "command": "milo.undo",
        "when": "isWorkspaceTrusted && !inputFocus",
        "key": "ctrl+k ctrl+alt+u",
        "mac": "cmd+k ctrl+alt+u"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "research:contract": "node scripts/runtime-contract.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:editor": "node scripts/run-editor-tests.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@truefoundry/trueforge-sdk": "0.185.0",
    "diff": "8.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.15.30",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.25.12",
    "jsonc-parser": "3.3.1",
    "mocha": "12.0.3",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ayushman4107/Milo-AI-TrueFoundry-.git"
  }
}
